<?xml version="1.0" encoding="utf-8"?>

<Page
    x:Class="Caelum.Pages.ProphetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Caelum.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
        Two bubble templates, one per speaker. The selector in the code behind picks between them
        from the message, so the student's own messages sit on the right in the accent colour and
        the assistant's on the left on the card surface.

        The assistant bubble carries a progress ring that is only visible while the answer is still
        arriving, so a streamed reply reads the way a live one would.

        The item style drops the list's own padding and minimum height: a chat row is exactly as
        tall as its bubble, and the bubble carries its own inset.
    -->
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <Style
            x:Key="ChatItemStyle"
            TargetType="ListViewItem"
            BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <DataTemplate x:Key="UserMessageTemplate">
            <Grid>
                <Border
                    HorizontalAlignment="Right"
                    MaxWidth="520"
                    Padding="12,8"
                    CornerRadius="12"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}">
                    <TextBlock
                        Text="{Binding Text}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AssistantMessageTemplate">
            <Grid>
                <Border
                    HorizontalAlignment="Left"
                    MaxWidth="520"
                    Padding="12,8"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            IsActive="{Binding IsPending}"
                            Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock
                            MinWidth="40"
                            Text="{Binding Text}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            x:Name="TitleText"
            Style="{StaticResource TitleTextBlockStyle}" />

        <!--
            Shown when no model provider has been configured, so the student is told what to do
            instead of being left with a send button that cannot work.
        -->
        <Border
            Grid.Row="1"
            x:Name="SetupBanner"
            Padding="12"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="SetupBannerText"
                    TextWrapping="Wrap" />

                <Button
                    x:Name="OpenSettingsButton"
                    HorizontalAlignment="Left"
                    Click="OnOpenSettings" />
            </StackPanel>
        </Border>

        <ListView
            Grid.Row="2"
            x:Name="MessagesList"
            Background="Transparent"
            SelectionMode="None"
            IsItemClickEnabled="False"
            ItemContainerStyle="{StaticResource ChatItemStyle}" />

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                x:Name="UploadButton"
                Padding="12,8"
                MinWidth="0">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE728;" />
            </Button>

            <!--
                A multi line rich text box. The preview key handler, attached with handled events
                so the control cannot swallow the key, makes Enter send and Shift+Enter drop a new
                line; see OnPromptPreviewKeyDown.
            -->
            <RichEditBox
                Grid.Column="1"
                x:Name="PromptBox"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                AcceptsReturn="True"
                MaxHeight="150"
                TextChanged="OnPromptTextChanged" />

            <Button
                Grid.Column="2"
                x:Name="SendButton"
                Padding="12,8"
                MinWidth="0"
                IsEnabled="False"
                Click="OnSend">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Glyph="&#xE724;" />
            </Button>
        </Grid>
    </Grid>
</Page>
